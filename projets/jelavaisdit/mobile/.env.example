# Copier ce fichier en `.env` et remplir les valeurs (le fichier .env n'est jamais envoyé sur GitHub).
# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# Adresse de la page web de la carte (dossier `web/` une fois en ligne)
EXPO_PUBLIC_URL_CARTE=https://VOTRE-SITE/carte/
