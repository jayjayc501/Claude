  "sous_titres": [
    {
      "debut": 0.0,
      "fin": 2.26,
      "texte": "*Odin* va-t-il se faire dévorer par ce *loup* ?"
    },
    {
      "debut": 3.16,
      "fin": 5.7,
      "texte": "Il a payé de son *sang* pour avoir la réponse."
    },
    {
      "debut": 6.08,
      "fin": 8.45,
      "texte": "Odin, c'est le *Père-de-Tout*."
    },
    {
      "debut": 9.04,
      "fin": 11.11,
      "texte": "Mais il y a une chose qu'il ne contrôle pas :"
    },
    {
      "debut": 11.87,
      "fin": 12.67,
      "texte": "*l'avenir*."
    },
    {
      "debut": 13.08,
      "fin": 17.22,
      "texte": "Alors il descend sous les racines d'*Yggdrasil*, l'arbre de vie."
    },
    {
      "debut": 17.78,
      "fin": 22.68,
      "texte": "Il arrive au puits de *Mímir* : boire son eau donne la réponse à toutes les questions."
    },
    {
      "debut": 23.39,
      "fin": 24.85,
      "texte": "Mais tout savoir a un *prix*."
    },
    {
      "debut": 25.29,
      "fin": 29.8,
      "texte": "Mímir, le gardien du puits, exige un *œil* pour une gorgée."
    },
    {
      "debut": 30.3,
      "fin": 34.27,
      "texte": "Odin *s'arrache* l'œil et le jette au fond du puits, avant de boire."
    },
    {
      "debut": 34.61,
      "fin": 35.1,
      "texte": "Et là,"
    },
    {
      "debut": 35.28,
      "fin": 36.25,
      "texte": "il comprend *tout* :"
    },
    {
      "debut": 36.52,
      "fin": 38.77,
      "texte": "le passé, le destin des hommes…"
    },
    {
      "debut": 38.86,
      "fin": 40.11,
      "texte": "le *Ragnarök*."
    },
    {
      "debut": 40.89,
      "fin": 47.39,
      "texte": "Ce jour-là, *Fenrir* sera libéré et *dévorera* *Odin*, avant que le *feu* ne marque la fin du monde."
    }
  ],
  "son_plans": 0.35
}