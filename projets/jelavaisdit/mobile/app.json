{
  "expo": {
    "name": "Je l'avais dit",
    "slug": "jelavaisdit",
    "scheme": "jelavaisdit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0C12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.jelavaisdit"
    },
    "android": {
      "package": "app.jelavaisdit",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0C12"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/Claude/app"
    }
  }
}
